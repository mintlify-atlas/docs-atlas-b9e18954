  "keyFeatures": [
    "No-survivorship monthly baskets frozen from prior-month Binance volume data",
    "Six-window BTC trend gate (20–45 days) that scales crypto exposure from 0 to 1",
    "PAXG gold counter-position absorbs the fraction of the deposit kept out of crypto",
    "Weekly time-exit positions reopened every tick; no look-ahead by construction",
    "Yahoo Finance daily bars sampled to minute candles via backtest-kit's getCandlesSampled",
    "73 self-contained month folders stamped from a single reference month",
    "Universe builder, Yahoo ticker resolver and price verifier pipeline in scripts/common/",
    "Multi-asset portfolio variant (BTC, Gold, SPX, TLT) with risk-parity weighting",
    "Cross-platform runner scripts (bash and .bat) auto-generated by generate_months.mjs",
    "Summarizer collapses all monthly JSONL reports into one P&L and drawdown table"
  ],
  "publicApiSurface": [
    "npm start -- --backtest --entry ./content/<month>/main.strategy.ts",
    "npm start -- --backtest --ui --entry ./content/<month>/main.strategy.ts",
    "node scripts/common/build_universe.mjs [--top 20] [--from YYYY-MM] [--to YYYY-MM] [--refresh]",
    "node scripts/common/resolve_yahoo_tickers.mjs [--refresh | --refresh-missing]",
    "node scripts/common/verify_yahoo_tickers.mjs [--only SYM1,SYM2]",
    "node scripts/common/generate_months.mjs [--source content/sep_2020]",
    "node scripts/common/summarize_reports.mjs [--deposit 1000]",
    "bash scripts/linux/generate_strategy.sh",
    "scripts/win/generate_strategy.bat",
    "YahooFinance.getCandles(ticker, '1d', since, limit)",
    "addStrategySchema({ strategyName, interval, getSignal })",
    "addExchangeSchema({ exchangeName, getCandles })",
    "addFrameSchema({ frameName, interval, startDate, endDate, note })",
    "addLauncherSchema({ launcherName, backtest, symbolList, cache })",
    "Cache.fn(async () => ..., { interval: '1d' })",
    "Position.bracket({ position, currentPrice, percentStopLoss, percentTakeProfit })",
    "getCandles(symbol, interval, limit)",
    "getCandlesSampled(fetchOHLCV, { symbol, interval, since, limit })",
    "PersistCandleAdapter.useDummy()",
    "listenDoneBacktest(callback)",
    "setConfig({ CC_BACKTEST_STEP_MINUTES, CC_MAX_STOPLOSS_DISTANCE_PERCENT, ... })"
  ]
}
